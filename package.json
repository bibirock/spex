{
  "name": "spex-cli",
  "version": "0.9.0",
  "private": true,
  "description": "將 spex skills 與 MCP 設定一鍵安裝到 Claude Code / GitHub Copilot 等 AI 代理工作環境",
  "type": "module",
  "bin": {
    "spex": "./bin/spex.js"
  },
  "files": [
    "bin",
    "dist",
    "assets",
    "README.md"
  ],
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node bin/spex.js",
    "test": "node --test dist/**/*.test.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "bump:version": "npm version --no-git-tag-version"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.0",
    "@types/prompts": "^2.4.9",
    "playwright-core": "^1.60.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
