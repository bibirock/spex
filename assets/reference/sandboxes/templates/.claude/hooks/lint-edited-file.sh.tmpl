{{#SKIP_IF_NOT HAS_POST_EDIT_LINTER}}
#!/usr/bin/env bash
# Claude Code PostToolUse hook（由 {{ID}} Sandbox Profile 生成）
# 作用：Claude 透過 Edit / Write / MultiEdit 異動檔案後，對「剛異動的那一個檔」跑 lint。
# 設計：只 lint 單檔；有 error 時以 exit code 2 把訊息回報給 Claude，讓它接著修正。
set -euo pipefail

_hook_input="$(cat)"
file_path="$(printf '%s' "$_hook_input" | jq -r '.tool_input.file_path // empty' 2>/dev/null || true)"
if [ -z "$file_path" ]; then
  file_path="$(printf '%s' "$_hook_input" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{process.stdout.write(((JSON.parse(s).tool_input)||{}).file_path||"")}catch(e){}})' 2>/dev/null || true)"
fi

[ -n "$file_path" ] || exit 0
[ -f "$file_path" ] || exit 0

case "$file_path" in
  {{POST_EDIT_LINTER_EXT_CASE}}) ;;
  *) exit 0 ;;
esac

linter_cmd="${CLAUDE_PROJECT_DIR:-.}/{{POST_EDIT_LINTER_COMMAND}}"
# shellcheck disable=SC2086　（需要讓 linter_cmd 的空白分隔旗標各自成獨立 argv）
if output="$($linter_cmd "$file_path" 2>&1)"; then
  exit 0
fi

echo "Lint 在 $file_path 發現問題，請修正：" >&2
echo "$output" >&2
exit 2
