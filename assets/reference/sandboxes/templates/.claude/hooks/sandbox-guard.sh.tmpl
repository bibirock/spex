#!/usr/bin/env bash
# Claude Code PreToolUse hook——雙平面硬防護（sandbox two-plane，見 .claude/rules/sandbox.md）。
# 由 {{ID}} Sandbox Profile 生成（.claude/reference/sandboxes/{{ID}}.md）。
# 同一支腳本兩側通用，依環境自動分流：
#   host（權限平面）：禁止直接編輯源碼、禁止直接執行套件管理器/直譯器等 → 引導改走 sandbox/dispatch.sh
#   沙盒（程式碼平面，IN_SANDBOX=1）：放行編輯與執行，改擋 git commit/push/config 與 az/gh/curl/wget
# exit 2 = 硬擋（stderr 回饋給 Claude）；exit 0 = 放行。hook 不受 bypassPermissions 影響。
set -euo pipefail

input="$(cat)"
tool_name="$(jq -r '.tool_name // empty' <<<"$input" 2>/dev/null || true)"
[ -n "$tool_name" ] || exit 0

in_sandbox=0
if [ "${IN_SANDBOX:-}" = '1' ] || [ -f /.dockerenv ]; then
  in_sandbox=1
fi

# 把 Bash 指令拆成 pipeline / 連接詞段，取每段第一個「指令詞」（略過 VAR=xx 與 sudo 等 wrapper）
first_words() {
  jq -r '.tool_input.command // empty' <<<"$input" 2>/dev/null |
    tr '\n' ';' | sed -E 's/(\|\||&&|\||;)/\n/g' |
    while IFS= read -r seg; do
      for w in $seg; do
        case "$w" in
          *=*) continue ;;
          sudo | command | exec | time | env) continue ;;
        esac
        echo "$w"
        break
      done
    done
}

if [ "$in_sandbox" = '1' ]; then
  # ── 沙盒側（程式碼平面）：擋權限平面操作 ──────────────────────────
  [ "$tool_name" = 'Bash' ] || exit 0
  cmd="$(jq -r '.tool_input.command // empty' <<<"$input" 2>/dev/null || true)"
  while IFS= read -r w; do
    case "$w" in
      az | gh | curl | wget)
        echo "沙盒（程式碼平面）禁止 ${w}：tracker / PR / raw HTTP 屬 host 權限平面（.claude/rules/sandbox.md）。" >&2
        exit 2
        ;;
      git)
        if grep -qE '(^|[;&|]|[[:space:]])git[[:space:]]+(commit|push|config)\b' <<<"$cmd"; then
          echo '沙盒（程式碼平面）禁止 git commit/push/config：commit 由 host 權限平面審核 diff 後執行（.claude/rules/sandbox.md）。' >&2
          exit 2
        fi
        if grep -qE '(^|[;&|]|[[:space:]])git[[:space:]]+stash[[:space:]]+(drop|clear)\b' <<<"$cmd"; then
          echo '沙盒禁止 git stash drop/clear：共享工作樹的 stash 可能含 host 狀態，銷毀性操作由 host 執行。' >&2
          exit 2
        fi
        ;;
    esac
  done < <(first_words)
  exit 0
fi

{{#IF TRACKER_CARD_GUARD}}
# ── 程式注入硬閘：dispatch prompt 檔（sandbox/tasks/<id>[-phase].prompt.md）
#    必須逐字包含 {{TRACKER_ADAPTER_ID}}-relay.py render 產生的 <id>.card.md 圍欄，防止 LLM 手動改寫/摘要
#    卡片內容。以「檔名前綴 id」而非「內文掃 #數字」判定目標卡（.claude/rules/sandbox.md）──
check_card_injection() {
  local file_path="$1" content="$2" repo="$3" base id card tmp
  base="$(basename "$file_path")"
  id="$(sed -E 's/^([0-9]+).*/\1/' <<<"$base")"
  [[ "$id" =~ ^[0-9]+$ ]] || return 0 # 非 <id>-prefixed 檔名（如 T-001.prompt.md）不受管
  card="$repo/sandbox/tasks/${id}.card.md"
  if [ ! -f "$card" ]; then
    echo "prompt 檔名以 #${id} 開頭但找不到 sandbox/tasks/${id}.card.md：請先執行「python3 sandbox/{{TRACKER_ADAPTER_ID}}-relay.py render ${id}」用程式注入卡片原文，再把該檔內容逐字貼入 prompt（禁止手動改寫／摘要，.claude/rules/sandbox.md 程式注入硬閘）。" >&2
    return 2
  fi
  tmp="$(mktemp)"
  printf '%s' "$content" >"$tmp"
  if ! python3 - "$card" "$tmp" <<'PYEOF'
import sys
frag = open(sys.argv[1], encoding="utf-8").read()
body = open(sys.argv[2], encoding="utf-8").read()
sys.exit(0 if frag in body else 1)
PYEOF
  then
    rm -f "$tmp"
    echo "prompt 檔未逐字包含 sandbox/tasks/${id}.card.md 的卡片原文圍欄（疑似手動改寫／摘要）：重新以「python3 sandbox/{{TRACKER_ADAPTER_ID}}-relay.py render ${id}」的輸出逐字貼入，不可手改內容（.claude/rules/sandbox.md 程式注入硬閘）。" >&2
    return 2
  fi
  rm -f "$tmp"
  return 0
}
{{/IF}}

# ── host 側（權限平面）：碼類動作一律引導進沙盒 ──────────────────────
repo="${CLAUDE_PROJECT_DIR:-$(pwd)}"

{{#IF SDD_SKILL_GUARD}}
# ── challenger/verifier 派發硬閘（不論 tool_name，只認 subagent_type）：
#    章戳鏈的影子流只在「沙盒內 claude 自己呼叫 Agent 工具」這條路徑下才會被
#    dispatch-watchdog-host.sh 捕獲；host 直接派發 challenger/verifier 等於繞過整條章戳鏈信任模型──
subagent="$(jq -r '.tool_input.subagent_type // empty' <<<"$input" 2>/dev/null || true)"
case "$subagent" in
  challenger | verifier)
    echo "host（權限平面）禁止直接派發 ${subagent} agent：詰問／驗收的章戳鏈只在沙盒 dispatch 路徑下才有影子流可驗（dispatch-watchdog-host.sh 只捕獲沙盒內 claude 的呼叫）。請改用 sandbox/dispatch.sh 打包整個 task/implement/selfcheck 階段派工，由沙盒內的 claude 自己載入對應 skill 並派發 ${subagent}（.claude/rules/sandbox.md）。" >&2
    exit 2
    ;;
esac

# ── 沙盒專屬 skill 硬閘（tool_name=Skill）：二分法，無中間地帶──
skill_name="$(jq -r '.tool_input.skill // empty' <<<"$input" 2>/dev/null || true)"
case "$skill_name" in
  spex-plan | spex-fixbug | spex-task | spex-implement | spex-selfcheck | spex-challenge)
    echo "host（權限平面）禁止直接載入 ${skill_name}：本 skill 須整階段打包為自足 prompt，經 sandbox/dispatch.sh 派工，由沙盒內的 claude 自己載入執行（.claude/rules/sandbox.md）。" >&2
    exit 2
    ;;
esac
{{/IF}}

case "$tool_name" in
  Edit | Write | MultiEdit)
    file_path="$(jq -r '.tool_input.file_path // empty' <<<"$input" 2>/dev/null || true)"
    [ -n "$file_path" ] || exit 0
    case "$file_path" in
      {{#IF TRACKER_CARD_GUARD}}
      "$repo"/sandbox/tasks/*.prompt.md)
        content="$(jq -r '(.tool_input.content // .tool_input.new_string // ((.tool_input.edits // []) | map(.new_string) | join("\n")))' <<<"$input" 2>/dev/null || true)"
        if [ -n "$content" ]; then
          check_card_injection "$file_path" "$content" "$repo" || exit 2
        fi
        exit 0
        ;;
      {{/IF}}
      "$repo"/.claude/* | "$repo"/sandbox/* | "$repo"/.devcontainer/*)
        exit 0 # 治理 / 沙盒基建可在 host 編輯
        ;;
      "$repo"/*)
        echo "host（權限平面）禁止直接編輯 ${file_path}：請把任務打包成 prompt 檔，經 sandbox/dispatch.sh 交由沙盒執行（.claude/rules/sandbox.md）。" >&2
        exit 2
        ;;
      *)
        exit 0 # repo 外（plan 檔、scratchpad）不在管制範圍
        ;;
    esac
    ;;
  Bash)
{{#IF HAS_HOST_BLOCKED_COMMANDS}}
    while IFS= read -r w; do
      case "$w" in
        {{HOST_BLOCKED_COMMANDS_PATTERN}})
          echo "host（權限平面）禁止直接執行 ${w}：驗證請用 sandbox/dispatch.sh --verify / --e2e，寫碼任務請打包 prompt 經 dispatch 進沙盒（.claude/rules/sandbox.md）。" >&2
          exit 2
          ;;
      esac
    done < <(first_words)
{{/IF}}
    exit 0
    ;;
esac
exit 0
