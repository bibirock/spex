#!/usr/bin/env node
// 沙盒環境 preflight（避免 e2e 因誤判「無 DB」而被錯誤跳過）。
// 由 {{ID}} Sandbox Profile 生成（.claude/reference/sandboxes/{{ID}}.md）。
// 用法：node env-check.mjs；輸出各項 OK/FAIL 與證據，任一 FAIL → exit 1。
// blocker 宣稱（跑不動/連不上）必附本腳本輸出。
import { execSync } from 'node:child_process';
import { connect } from 'node:net';
import { existsSync } from 'node:fs';

const results = [];
const add = (name, ok, evidence) => results.push({ name, ok, evidence });

// 1. 依賴就緒哨兵
add(
  'deps-ready',
  existsSync('{{DEPS_READY_MARKER_PATH}}'),
  '{{DEPS_READY_MARKER_PATH}}',
);

{{#IF HAS_SIDECAR}}
// 2. Sidecar TCP 連通性（見 Sandbox Profile sidecarServices 的 containerPort 宣告）
const sidecarChecks = {{SIDECAR_TCP_CHECKS_JS}};
for (const { name, port } of sidecarChecks) {
  // eslint-disable-next-line no-await-in-loop
  await new Promise((resolve) => {
    const s = connect(port, name, () => {
      add(`sidecar:${name}`, true, `${name}:${port} 可達`);
      s.end();
      resolve();
    });
    s.setTimeout(5000, () => {
      add(`sidecar:${name}`, false, 'timeout 5s');
      s.destroy();
      resolve();
    });
    s.on('error', (e) => {
      add(`sidecar:${name}`, false, e.message);
      resolve();
    });
  });
}
{{/IF}}

// 3. 沙盒側工具語言（node）版本——與目標專案語言無關，見 Dockerfile 附註
try {
  add(
    'node',
    true,
    execSync('node --version', { timeout: 30000 }).toString().trim(),
  );
} catch (e) {
  add('node', false, e.message.slice(0, 120));
}

let fail = 0;
for (const r of results) {
  if (!r.ok) fail++;
  console.log(`${r.ok ? 'OK  ' : 'FAIL'} ${r.name}: ${r.evidence}`);
}
console.log(fail ? `env-check: ${fail} 項 FAIL` : 'env-check: 全部 OK');
process.exit(fail ? 1 : 0);
