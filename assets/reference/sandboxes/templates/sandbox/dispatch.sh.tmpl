set -euo pipefail

SANDBOX_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DISPATCH_MODE="${1:-}"
DISPATCH_REPO="${DISPATCH_REPO:-service}"
case "$DISPATCH_REPO" in
{{WORKDIR_CASE_BRANCHES}}
  *)
    echo "未知 DISPATCH_REPO=${DISPATCH_REPO}（僅支援 {{DISPATCH_REPO_NAMES_PATTERN}}）" >&2
    exit 65
    ;;
esac
DISPATCH_MODEL="${DISPATCH_MODEL:-}"
if [ -z "$DISPATCH_MODEL" ] && [ -f "$SANDBOX_DIR/.training-model" ]; then
  DISPATCH_MODEL="$(head -1 "$SANDBOX_DIR/.training-model" | tr -d '[:space:]')"
fi
case "$DISPATCH_MODE" in
  --verify | --bootstrap | --diff-cov | --run | --e2e | --reset-db | '') ;; # 不啟動沙盒內 claude，免模型
  *)
    if [ -z "$DISPATCH_MODEL" ]; then
      echo '缺少 DISPATCH_MODEL：沙盒模型須繼承 host 目前使用的模型，呼叫端必須顯式帶入（如 DISPATCH_MODEL=claude-sonnet-5 sandbox/dispatch.sh ...），不得留白讓沙盒退回自身登入預設。' >&2
      exit 65
    fi
    ;;
esac
CLAUDE_CMD='claude -p --dangerously-skip-permissions'
if [ -n "${DISPATCH_MODEL:-}" ]; then
  CLAUDE_CMD="$CLAUDE_CMD --model ${DISPATCH_MODEL}"
fi
DISPATCH_VERBOSE="${DISPATCH_VERBOSE-1}"
[ "$DISPATCH_VERBOSE" = "0" ] && DISPATCH_VERBOSE=""
if [ -n "${DISPATCH_VERBOSE:-}" ]; then
  CLAUDE_CMD="$CLAUDE_CMD --verbose --output-format stream-json"
fi
# --resume <session_id> <prompt-file>：對既有沙盒 session 續行（ASK-USER 答覆回填 / 確認點代答）。
if [ "${1:-}" = '--resume' ]; then
  RESUME_SID="${2:-}"
  { [ -n "$RESUME_SID" ] && [ -n "${3:-}" ]; } || {
    echo '用法：dispatch.sh --resume <session_id> <prompt-file>' >&2
    exit 64
  }
  CLAUDE_CMD="$CLAUDE_CMD --resume ${RESUME_SID}"
  shift 2
fi

COMPOSE=(docker compose -f "$SANDBOX_DIR/docker-compose.sandbox.yml")

# 每個 host 工作 session 首次派工時，給沙盒一個乾淨上下文基線（清 ~/.claude 累積載體，保留登入 token）。
HOST_SESSION_MARKER="$SANDBOX_DIR/tasks/.host-session"
if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
  PREV_SESSION="$(cat "$HOST_SESSION_MARKER" 2>/dev/null || true)"
  if [ "$PREV_SESSION" != "$CLAUDE_CODE_SESSION_ID" ]; then
    if [ "$DISPATCH_MODE" != "--resume" ]; then
      echo "[dispatch] 本 host session 首次派工，清沙盒累積上下文（保留登入）…" >&2
      "$SANDBOX_DIR/reset-context.sh" || echo "[dispatch] reset-context 非零退出，繼續派工（見上）" >&2
    fi
    mkdir -p "$(dirname "$HOST_SESSION_MARKER")"
    printf '%s\n' "$CLAUDE_CODE_SESSION_ID" >"$HOST_SESSION_MARKER"
  fi
fi

ensure_up() {
  "${COMPOSE[@]}" --progress quiet up -d sandbox >/dev/null
  "${COMPOSE[@]}" exec -T sandbox sudo /usr/local/bin/init-firewall.sh >/dev/null
}

run_in_sandbox() {
  "${COMPOSE[@]}" exec -T sandbox bash -o pipefail -c "cd $WORKDIR && { $1 ; } 2>&1 | tee /proc/1/fd/1"
}

run_bootstrap() {
  case "$DISPATCH_REPO" in
{{BOOTSTRAP_CASE_BRANCHES}}
  esac
}

ensure_deps() {
  case "$DISPATCH_REPO" in
{{DEPS_MARKER_CASE_BRANCHES}}
  esac
  if ! "${COMPOSE[@]}" exec -T sandbox test -e "$DEPS_MARKER" 2>/dev/null; then
    echo '依賴未就緒，先 bootstrap…' >&2
    run_bootstrap
  fi
}

case "${1:-}" in
  --bootstrap)
    ensure_up
    run_bootstrap
    ;;
  --reset-db)
    ensure_up
    ensure_deps
    run_in_sandbox '{{RESET_DB_COMMAND}}'
    ;;
  --verify)
    ensure_up
    ensure_deps
    case "$DISPATCH_REPO" in
{{VERIFY_CASE_BRANCHES}}
    esac
    ;;
  --diff-cov)
    shift
    ensure_up
    run_in_sandbox "{{DIFF_COV_TOOL}} $*"
    ;;
  --run)
    SCRIPT_FILE="${2:-}"
    [ -n "$SCRIPT_FILE" ] || {
      echo '用法：dispatch.sh --run <script>' >&2
      exit 64
    }
    ensure_up
    run_in_sandbox "node $SCRIPT_FILE"
    ;;
  --explore)
    PROMPT_FILE="${2:-}"
    [ -f "$PROMPT_FILE" ] || {
      echo "prompt 檔不存在：${PROMPT_FILE}" >&2
      exit 66
    }
    ensure_up
    ensure_deps
    mkdir -p "$SANDBOX_DIR/tasks"
    BASENAME="$(basename "$PROMPT_FILE")"
    RESULT_FILE="$SANDBOX_DIR/tasks/${BASENAME%.prompt.md}.explore.md"
    set +e
    {
      echo '【唯讀探索模式】禁止建立、修改、刪除任何檔案與 git 狀態；只允許讀碼與唯讀指令；輸出精簡結構化摘要（結論 + file:line 證據），不要貼大段原文。'
      echo
      cat "$PROMPT_FILE"
    } | "${COMPOSE[@]}" exec -T sandbox bash -o pipefail -c "cd $WORKDIR && $CLAUDE_CMD 2>&1 | tee /proc/1/fd/1" \
      >"$RESULT_FILE" 2>&1
    STATUS=$?
    set -e
    echo "result: ${RESULT_FILE}（exit ${STATUS}）"
    exit "$STATUS"
    ;;
  --e2e)
    ensure_up
    ensure_deps
    case "$DISPATCH_REPO" in
{{E2E_CASE_BRANCHES}}
    esac
    ;;
  '')
    echo '用法：dispatch.sh <prompt-file> | --explore <prompt-file> | --verify | --e2e | --bootstrap' >&2
    exit 64
    ;;
  *)
    PROMPT_FILE="$1"
    [ -f "$PROMPT_FILE" ] || {
      echo "prompt 檔不存在：$PROMPT_FILE" >&2
      exit 66
    }
    ensure_up
    ensure_deps
    mkdir -p "$SANDBOX_DIR/tasks"
    BASENAME="$(basename "$PROMPT_FILE")"
    STEM="${BASENAME%.prompt.md}"
    RESULT_FILE="$SANDBOX_DIR/tasks/${STEM}.result.md"
    # DISPATCH_DETACH=1：容器內背景執行，輸出寫 workspace 內 result 檔，結尾寫 sentinel [DISPATCH-DONE exit=N]。
    SHADOW_DIR="${DISPATCH_SHADOW_DIR:-$HOME/.sandbox-shadow/$(basename "$(cd "$SANDBOX_DIR/.." && pwd)")}"
    mkdir -p "$SHADOW_DIR/tools"
    # 稽核工具快照：驗章一律跑 $SHADOW_DIR/tools 內的 host-only 副本，避免沙盒竄改掛載區的稽核腳本本體。
    # 驗章器由 spex 安裝於 .claude/reference/spex/scripts/；sandbox/ 內的 Python 工具（relay 執行檔與
    # 其輔助模組）由 /spex-relay-init 依該專案的 tracker 生成——檔名因 tracker 而異，故一律整批快照，
    # 不在此寫死任何檔名（寫死等於把樣板綁定到特定 tracker）。
    _repo_root="$(cd "$SANDBOX_DIR/.." && pwd)"
    if [ -f "$_repo_root/.claude/reference/spex/scripts/challenge-audit.py" ]; then
      cp -f "$_repo_root/.claude/reference/spex/scripts/challenge-audit.py" "$SHADOW_DIR/tools/"
    fi
    for _tool in "$SANDBOX_DIR"/*.py; do
      if [ -f "$_tool" ]; then
        cp -f "$_tool" "$SHADOW_DIR/tools/"
      fi
    done
    SHADOW_FILE="$SHADOW_DIR/${STEM}.result.md"
    if [ -n "${DISPATCH_DETACH:-}" ]; then
      HARDCAP="${DISPATCH_TIMEOUT:-7200}"
      DSTALE=0
      [ -n "${DISPATCH_VERBOSE:-}" ] && DSTALE="${DISPATCH_STALE:-300}"
      WD_PROMPT="$PROMPT_FILE" WD_SHADOW="$SHADOW_FILE" WD_MIRROR="$RESULT_FILE" \
        WD_CMD="$CLAUDE_CMD" WD_STALE="$DSTALE" WD_HARDCAP="$HARDCAP" \
        WD_COMPOSE="$SANDBOX_DIR/docker-compose.sandbox.yml" WD_WORKDIR="$WORKDIR" \
        nohup bash "$SANDBOX_DIR/dispatch-watchdog-host.sh" >/dev/null 2>&1 &
      disown
      echo "detached: 鏡像 ${RESULT_FILE}｜影子流 ${SHADOW_FILE}（驗章來源）"
      echo "（host 看門狗：停滯>${DSTALE}s 判 hung〔0=停用〕；絕對上限 ${HARDCAP}s；等 sentinel [DISPATCH-DONE exit=N]）"
      exit 0
    fi
    set +e
    "${COMPOSE[@]}" exec -T sandbox bash -o pipefail -c "cd $WORKDIR && $CLAUDE_CMD 2>&1 | tee /proc/1/fd/1" \
      <"$PROMPT_FILE" 2>&1 | tee "$SHADOW_FILE" >"$RESULT_FILE"
    STATUS=${PIPESTATUS[0]}
    set -e
    if [ -n "${DISPATCH_VERBOSE:-}" ]; then
      STREAM_FILE="$SANDBOX_DIR/tasks/${BASENAME%.prompt.md}.stream.jsonl"
      mv "$RESULT_FILE" "$STREAM_FILE"
      python3 -c '
import json, sys
res = ""
for line in open(sys.argv[1], encoding="utf-8", errors="replace"):
    line = line.strip()
    if not line.startswith("{"):
        continue
    try:
        ev = json.loads(line)
    except Exception:
        continue
    if ev.get("type") == "result":
        res = ev.get("result") or json.dumps(ev, ensure_ascii=False)
print(res)
' "$STREAM_FILE" >"$RESULT_FILE" || cp "$STREAM_FILE" "$RESULT_FILE"
    fi
    echo "result: ${RESULT_FILE}（exit ${STATUS}）"
    exit "$STATUS"
    ;;
esac
